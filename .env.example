# SmartCart AI Environment Configuration Template
# Copy this file to .env for local development. DO NOT commit .env to GitHub.

# ==========================================
# Backend Configuration (Flask & SQLAlchemy)
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-token-in-production
PORT=5000
HOST=127.0.0.1

# Database URL
# Local default (SQLite):
DATABASE_URL=sqlite:///smartcart.db
# Managed MySQL (AWS RDS / Aiven / PlanetScale / DigitalOcean):
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name?ssl_ca=/path/to/ca.pem
# Managed PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# CORS Allowed Origins
# Local dev: "*" or "http://localhost:3000,http://127.0.0.1:3000"
# Production: "https://your-frontend-app.vercel.app"
CORS_ORIGINS=*

# Automatic Fixture Seeding (true or false)
AUTO_SEED=true

# Optional Admin Key for privileged endpoints
# SMARTCART_ADMIN_API_KEY=your-admin-key-here

# ==========================================
# Frontend Configuration (Vite & React)
# ==========================================
# Local development (uses Vite dev server proxy to localhost:5000):
VITE_API_BASE_URL=http://127.0.0.1:5000/api
# Production deployment on Vercel (target your deployed Render service):
# VITE_API_BASE_URL=https://your-smartcart-backend.onrender.com/api
VITE_PORT=3000
