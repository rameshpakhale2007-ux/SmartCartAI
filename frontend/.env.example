# SmartCart AI Frontend Environment Variables
# For local development with Vite dev server proxy to localhost:5000:
# Leave blank or set to:
# VITE_API_BASE_URL=http://127.0.0.1:5000/api

# For Vercel production deployment:
# Set this to your deployed Render backend URL:
VITE_API_BASE_URL=https://your-smartcart-backend.onrender.com/api
